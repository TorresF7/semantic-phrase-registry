# Copia este archivo como .env y ajusta los valores. .env no se versiona.
# Los valores son los de desarrollo local (docs/context/architecture.md).

# --- Backend ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://banco:banco@localhost:5432/banco_frases
# Base separada para los tests de integración: truncan la tabla.
TEST_DATABASE_URL=postgresql+psycopg://banco:banco@localhost:5432/banco_frases_test
# Umbral de posible duplicado, entre 0 y 1 (RN-06). Valor inicial; lo fija T-11.
SIMILARITY_THRESHOLD=0.80
# No cambiarlo con frases ya guardadas (B-13).
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
MAX_PHRASE_LENGTH=280
# Solo para desarrollo sin Docker. Lista separada por comas.
CORS_ORIGINS=http://localhost:5173
# En la imagen vale /home/app/.cache/huggingface.
HF_HOME=/home/app/.cache/huggingface
LOG_LEVEL=INFO

# --- Compose: servicio db (mismos valores que DATABASE_URL) -----------------
POSTGRES_USER=banco
POSTGRES_PASSWORD=banco
POSTGRES_DB=banco_frases

# --- Frontend (se incrustan en el paquete público: nada secreto) ------------
# En la imagen vale /api/v1.
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAX_PHRASE_LENGTH=280
